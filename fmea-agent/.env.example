# FMEA Agent 环境变量配置
# 复制此文件为 .env 并修改

# ── LLM 配置 ──
FMEA_MODEL_NAME=deepseek-chat
FMEA_MODEL_BASE_URL=https://api.deepseek.com
FMEA_MODEL_API_KEY=your-api-key-here

# ── PostgreSQL 数据库（必填）──
FMEA_DB_URL=postgresql+psycopg2://user:pass@host:5432/dbname

# ── 用户数据库（与 FMEA_DB_URL 同一 PG 实例）──
# 也支持独立 PG 实例
# URL_AGENT_DB_HOST=host
# URL_AGENT_DB_PORT=5432
# URL_AGENT_DB_NAME=fmea
# URL_AGENT_DB_USER=postgres
# URL_AGENT_DB_PASSWORD=password

# ── 服务配置 ──
FMEA_HOST=localhost
FMEA_PORT=7777
LOG_LEVEL=INFO

# ── 路径配置（可选，通常自动检测）──
# AGNO_PATH=D:/agent-fmea/agno/libs/agno
# FMEA_DATA_DIR=data/projects

# ── 飞书推送（v21.0: 通知通道，替代 SMTP 邮件）──
# 飞书开放平台应用凭证（必填，否则飞书推送自动跳过）
FEISHU_APP_ID=your-feishu-app-id
FEISHU_APP_SECRET=your-feishu-app-secret
